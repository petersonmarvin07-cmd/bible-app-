# Database connection string (optional — falls back to embedded PostgreSQL when unset or unreachable)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Demo account credentials (optional)
DEMO_EMAIL=grace@lumen.app
